{
  "name": "dsh-attest-chain",
  "version": "0.1.0",
  "description": "Signed chain-of-custody for DeepSeek Harness sessions: every watched tool result appends a hash-chained, ed25519-signed record — what the agent did, provable after the fact",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync": "node scripts/sync-aa-core.mjs",
    "test": "npm run sync && npm run build && node test/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test scripts",
    "coverage": "c8 --exclude \"test/**\" --check-coverage --lines 50 --branches 75 --functions 38 node test/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-agents",
    "attestation",
    "chain-of-custody",
    "in-toto"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "c8": "^12.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/zhengqiuyang/dsh-attest-chain#readme",
  "bugs": { "url": "https://github.com/zhengqiuyang/dsh-attest-chain/issues" },
  "author": "zhengqiuyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-attest-chain.git"
  }
}
